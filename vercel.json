{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "dashboard/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/event", "dest": "/api/event.py" },
    { "src": "/api/events", "dest": "/api/events.py" },
    { "src": "/", "dest": "/dashboard/index.html" }
  ]
}
